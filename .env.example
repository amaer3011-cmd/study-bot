BOT_TOKEN=123456:ABC...
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# اختياري
TZ_NAME=Africa/Cairo
TICK_SECONDS=10
MAX_SESSION_HOURS=12
CHALLENGE_DAILY_HOUR=6
LEADERBOARD_HOUR=20
CHALLENGE_ADMINS_ONLY=0
PRAYER_CITY=Cairo
PRAYER_COUNTRY=Egypt
# أذكار الصباح والمساء حسب TZ_NAME (الافتراضي 7 صباحًا و5 مساءً)
ADHKAR_MORNING_HOUR=7
ADHKAR_EVENING_HOUR=17
MAX_PAUSE_HOURS=3
BOARD_CACHE_SECONDS=300
# عدد الجروبات اللي بيتبعتلها بالتوازي في الرسائل المجدولة (أذكار/صلاة/لوحة..)
BROADCAST_CONCURRENCY=8
# 0 = تعطيل uvloop
USE_UVLOOP=0
# أقصى عدد اتصالات للداتابيز
DB_POOL_MAX=20
# ثواني بقاء اتصال تليجرام مفتوح وهو فاضي (بيوفّر handshake مع كل أمر بعد هدوء)
TG_KEEPALIVE=120
# 1 = HTTP/2 (محتاج: pip install "httpx[http2]")
TG_HTTP2=0
