BOT_TOKEN=123456:ABC...
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# اختياري
TZ_NAME=Africa/Cairo
TICK_SECONDS=10
MAX_SESSION_HOURS=12
CHALLENGE_DAILY_HOUR=6
LEADERBOARD_HOUR=20
CHALLENGE_ADMINS_ONLY=0
PRAYER_CITY=Cairo
PRAYER_COUNTRY=Egypt
# أذكار الصباح والمساء حسب TZ_NAME (الافتراضي 7 صباحًا و5 مساءً)
ADHKAR_MORNING_HOUR=7
ADHKAR_EVENING_HOUR=17
MAX_PAUSE_HOURS=3
BOARD_CACHE_SECONDS=300
# عدد الجروبات اللي بيتبعتلها بالتوازي في الرسائل المجدولة (أذكار/صلاة/لوحة..)
BROADCAST_CONCURRENCY=8
# 0 = تعطيل uvloop (اختياري: pip install uvloop ثم USE_UVLOOP=1)
USE_UVLOOP=0
# وقف المعسكر للصلاة: مدة الوقفة الافتراضية بالدقايق
PRAYER_PAUSE_MIN=15
# التاريخ الهجري: لو متقدم يوم عن دار الإفتاء ضع -1، ولو متأخر +1
HIJRI_OFFSET=0
# تذكير صيام بكرة (الساعة) + تذكيرات رمضان (دقايق قبل الفجر / بعد العشاء)
FASTING_REMIND_HOUR=21
RAMADAN_SUHOOR_MIN=45
RAMADAN_TARAWEEH_MIN=20

# لوحة تحكم المالك (/admin في الخاص): أيديك (ولو أكتر من واحد افصل بفاصلة). تعرف أيديك من /id
OWNER_IDS=123456789
